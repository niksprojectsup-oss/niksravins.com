generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ChecklistType {
  BEFORE
  CURRENT
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum JournalVisibility {
  PRIVATE
  SHARED
}

enum JournalCategory {
  PATTERN
  TRIGGER
  POSITIVE_OBSERVATION
}

enum TestimonialConsent {
  PRIVATE
  ANONYMOUS
  NAMED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GoalStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
}

enum CheckInMood {
  GREAT
  GOOD
  CALM
  NEUTRAL
  ANXIOUS
  LOW
  OVERWHELMED
}

enum AssessmentPhase {
  BEFORE
  AFTER
  ONGOING
}

enum UserRole {
  ADMIN
  CLIENT
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  totpSecret    String?
  lastLoginAt   DateTime?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AuditLog[]   @relation("AdminAuditActor")

  identityContentVersions IdentityContentVersion[]
  betaInvites          IdentityBetaInvite[]

  @@index([isActive])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           UserRole
  clientId       String?  @unique
  practitionerId String?
  mfaEnabled     Boolean  @default(false)
  totpSecret     String?
  emailVerified  DateTime?
  passwordSetAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client              Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  authSessions        AuthSession[]
  clientPasswordTokens ClientPasswordToken[]

  @@index([role])
  @@index([practitionerId])
}

model ClientPasswordToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorAdminId String?
  actorRole    UserRole?
  action       String
  resource     String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  admin AdminUser? @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@index([actorAdminId, createdAt])
}

model Client {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  email            String       @unique
  phone            String?
  country          String
  timezone         String       @default("Europe/Riga")
  status           ClientStatus @default(ACTIVE)
  firstSessionDate DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  profile          ClientProfile?
  reactionAnalysis ReactionAnalysis?
  checklists       Checklist[]
  sessions         Session[]
  payments         Payment[]
  bookings         Booking[]
  sessionPackages       SessionPackage[]
  user                  User?
  journalEntries        ClientJournalEntry[]
  checkIns              ClientCheckIn[]
  selfAssessments       ClientSelfAssessment[]
  goals                 ClientGoal[]
  sessionReflections    SessionReflection[]
  sessionPreparations   SessionPreparation[]
  milestones            ClientMilestone[]
  finalReflections      JourneyFinalReflection[]
  testimonials          Testimonial[]
  purchases               Purchase[]
  identitySubmissions       IdentityTestSubmission[]
  developmentTrunks         ClientDevelopmentTrunk[]
  developmentEvents         ClientDevelopmentEvent[]

  @@index([status])
  @@index([lastName, firstName])
}

model ClientProfile {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  practitionerNotes  String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ReactionAnalysis {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  mainConcern        String   @default("")
  triggers           String   @default("")
  automaticReactions String   @default("")
  bodySensations     String   @default("")
  emotionalResponses String   @default("")
  oldPatterns        String   @default("")
  currentResponses   String   @default("")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Checklist {
  id        String        @id @default(cuid())
  clientId  String
  type      ChecklistType
  itemKey   String
  checked   Boolean       @default(false)
  updatedAt DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, type, itemKey])
  @@index([clientId, type])
}

model Session {
  id             String        @id @default(cuid())
  clientId       String
  packageId      String?
  sessionNumber  Int?
  scheduledAt    DateTime
  sessionType    String
  serviceId      String?
  status         SessionStatus @default(SCHEDULED)
  mainTopic      String        @default("")
  notes          String        @default("")
  changesNoticed String        @default("")
  nextFocus      String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package       SessionPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  payments      Payment[]
  booking       Booking?
  reflection    SessionReflection?
  preparation   SessionPreparation?

  devTrunksInProgress ClientDevelopmentTrunk[] @relation("DevelopmentWorkSession")
  devTrunksCompleted  ClientDevelopmentTrunk[] @relation("DevelopmentCompletedSession")

  @@index([clientId, scheduledAt])
  @@index([packageId, sessionNumber])
  @@index([scheduledAt])
  @@index([status])
}

model SessionPackage {
  id                String        @id @default(cuid())
  clientId          String
  serviceId         String
  totalSessions     Int           @default(5)
  completedSessions Int           @default(0)
  status            PackageStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions          Session[]
  booking           Booking?
  payment           Payment?
  finalReflection   JourneyFinalReflection?

  @@index([clientId])
  @@index([status])
}

model ClientJournalEntry {
  id         String            @id @default(cuid())
  clientId   String
  content    String
  prompt     String            @default("")
  visibility JournalVisibility @default(PRIVATE)
  category   JournalCategory?
  observedOn String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, visibility])
  @@index([clientId, category])
}

model ClientCheckIn {
  id           String      @id @default(cuid())
  clientId     String
  checkInDate  String
  mood         CheckInMood
  emotionTags  String[]
  intensity    Int
  notes        String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, checkInDate])
  @@index([clientId, checkInDate])
}

model ClientSelfAssessment {
  id                String          @id @default(cuid())
  clientId          String
  phase             AssessmentPhase
  clarity           Int
  confidence        Int
  connection        Int
  movingForward     Int
  emotionalBalance  Int
  feelingStuck      Int
  packageId         String?
  createdAt         DateTime        @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, phase])
}

model ClientGoal {
  id          String     @id @default(cuid())
  clientId    String
  title       String
  description String     @default("")
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  updatedAt   DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model SessionReflection {
  id                       String   @id @default(cuid())
  clientId                 String
  sessionId                String   @unique
  rating                   Int
  valuablePart             String   @default("")
  whatShifted              String   @default("")
  takeaway                   String   @default("")
  messageToPractitioner    String   @default("")
  sharedWithPractitioner   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model SessionPreparation {
  id         String   @id @default(cuid())
  clientId   String
  sessionId  String   @unique
  reflection String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientMilestone {
  id           String   @id @default(cuid())
  clientId     String
  milestoneKey String
  packageId    String?
  achievedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, milestoneKey])
}

model JourneyFinalReflection {
  id             String   @id @default(cuid())
  clientId       String
  packageId      String   @unique
  whatChanged    String   @default("")
  mostValuable   String   @default("")
  selfDiscovery  String   @default("")
  takeForward    String   @default("")
  recommendation String   @default("")
  rating         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client  Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package SessionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Testimonial {
  id        String             @id @default(cuid())
  clientId  String
  packageId String?            @unique
  content   String             @default("")
  consent   TestimonialConsent @default(PRIVATE)
  status    TestimonialStatus  @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

enum OfferType {
  SINGLE_SESSION
  PACKAGE
  COURSE
}

model BookableOffer {
  id                String    @id
  slug              String    @unique
  title             String
  description       String    @db.Text
  detail            String    @default("") @db.Text
  offerType         OfferType
  priceCents        Int
  currency          String    @default("EUR")
  durationMinutes   Int       @default(45)
  durationLabel     String?
  priceLabel        String?
  checkoutNote      String?   @db.Text
  highlights        String[]  @default([])
  bonuses           String[]  @default([])
  packageSessions   Int?
  requiresStartDate Boolean   @default(false)
  active            Boolean   @default(true)
  published         Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, published, sortOrder])
}

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  sessionId        String        @unique
  packageId        String?       @unique
  serviceId        String
  slotId           String
  sessionIntention String        @default("")
  courseStartDate  DateTime?
  status           BookingStatus @default(CONFIRMED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  package SessionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  clientId    String
  sessionId   String?
  packageId   String?       @unique
  amountCents Int
  currency    String        @default("EUR")
  status      PaymentStatus @default(PENDING)
  provider    String?
  stripeCheckoutSessionId String? @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  package SessionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  purchase Purchase?

  @@index([clientId])
  @@index([sessionId])
}

enum StoreProductType {
  SESSION
  VIDEO
  MEDITATION
  COURSE
}

enum StoreProductStatus {
  DRAFT
  PUBLISHED
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

model StoreProduct {
  id                     String             @id @default(cuid())
  slug                   String             @unique
  title                  String
  description            String             @db.Text
  productType            StoreProductType
  priceCents             Int
  currency               String             @default("EUR")
  status                 StoreProductStatus @default(DRAFT)
  sortOrder              Int                @default(0)
  thumbnailUrl           String?
  contentKey             String?
  contentMimeType        String?
  contentDurationSeconds Int?
  bookableOfferId        String?
  licenseNotice          String?            @db.Text
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  purchases Purchase[]

  @@index([status, sortOrder])
}

model Purchase {
  id        String         @id @default(cuid())
  clientId  String
  productId String
  paymentId String?        @unique
  status    PurchaseStatus @default(PENDING)
  purchasedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  payment Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([productId])
  @@index([clientId, productId])
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

model CmsPage {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  status    CmsPageStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sections CmsSection[]

  @@index([status])
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  key       String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page  CmsPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items CmsContentItem[]

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

model CmsContentItem {
  id            String   @id @default(cuid())
  sectionId     String
  locale        String
  fieldKey      String
  draftJson     Json?
  publishedJson Json?
  plainText     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  section CmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale, fieldKey])
  @@index([sectionId, locale])
}

model TranslationEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  page      String
  section   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values TranslationValue[]

  @@index([page, section])
  @@index([sortOrder])
}

model TranslationValue {
  id             String   @id @default(cuid())
  entryId        String
  locale         String
  draftValue     String   @db.Text
  publishedValue String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entry TranslationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, locale])
  @@index([locale])
}

model BookingSettings {
  id              String   @id @default("default")
  businessTimezone String  @default("Europe/Riga")
  minNoticeHours  Int      @default(24)
  bufferMinutes   Int      @default(15)
  horizonDays     Int      @default(56)
  slotStepMinutes Int      @default(15)
  latvianBookingEnabled Boolean @default(true)
  updatedAt       DateTime @updatedAt
}

model WeeklyAvailability {
  id        String  @id @default(cuid())
  dayOfWeek Int
  enabled   Boolean @default(true)
  startTime String
  endTime   String
  note      String  @default("")

  @@unique([dayOfWeek])
}

model DailyTimeBlock {
  id        String  @id @default(cuid())
  startTime String
  endTime   String
  label     String
  active    Boolean @default(true)

  @@unique([startTime, endTime])
}

// ═══════════════════════════════════════════════════════════════════
// IDENTITY TEST — satura struktūra, rezultāti, e-pastu automatizācija
// ═══════════════════════════════════════════════════════════════════

enum IdentityContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  DISABLED
}

enum IdentityTranslationStatus {
  NOT_TRANSLATED
  AUTO_TRANSLATED
  NEEDS_REVIEW
  APPROVED
  PUBLISHED
}

enum IdentitySafetyFlag {
  VIOLENCE
  SEXUAL_VIOLENCE
  WAR
  SEVERE_LOSS
  SELF_HARM
  CRISIS
}

enum IdentityContentEntityType {
  THEME
  SUBCATEGORY
  BELIEF
  TRUNK
  BRANCH
  MECHANISM_TAG
  CONNECTOR
  SAFETY_TEXT
  CONSENT_TEXT
  EMAIL_TEMPLATE
}

enum IdentityConnectorKind {
  OPENING
  JOIN_SIMILAR
  JOIN_CONTRAST
  TRANSITION
  CLOSING
}

enum IdentityEmailStep {
  RESULT
  DAY_1
  DAY_3
  DAY_5
}

enum IdentityEmailKind {
  RESULT
  SEQUENCE_STEP
  ADMIN_TEST
}

enum IdentityDeliveryState {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum IdentitySequenceStatus {
  ACTIVE
  PROCESSING
  PAUSED
  COMPLETED
  CANCELLED
}

enum IdentitySubmissionStatus {
  RECEIVED
  VALIDATED
  RESULT_GENERATED
  REJECTED
}

enum IdentityVersionAction {
  UPDATE
  PUBLISH
  UNPUBLISH
  RESTORE
}

model IdentityTestTheme {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  sortOrder   Int                    @default(0)
  status      IdentityContentStatus  @default(DRAFT)
  isSensitive Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  subcategories IdentityTestSubcategory[]

  @@index([status, sortOrder])
}

model IdentityTestSubcategory {
  id        String                 @id @default(cuid())
  themeId   String
  slug      String
  sortOrder Int                    @default(0)
  status    IdentityContentStatus  @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  theme   IdentityTestTheme @relation(fields: [themeId], references: [id], onDelete: Restrict)
  beliefs IdentityBelief[]

  @@unique([themeId, slug])
  @@index([themeId, sortOrder])
}

model IdentityBelief {
  id            String                 @id @default(cuid())
  stableKey     String                 @unique
  subcategoryId String
  sortOrder     Int                    @default(0)
  status        IdentityContentStatus  @default(DRAFT)
  safetyFlags   IdentitySafetyFlag[]   @default([])
  adminNotes    String                 @default("") @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  subcategory IdentityTestSubcategory    @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  trunk       IdentityPositiveTrunk?
  mechanisms  IdentityBeliefMechanism[]
  trunkLinks  BeliefTrunkLink[]
  developmentTrunks ClientDevelopmentTrunk[]

  @@index([subcategoryId, sortOrder])
  @@index([status])
}

model IdentityMechanismTag {
  id        String                 @id @default(cuid())
  key       String                 @unique
  sortOrder Int                    @default(0)
  status    IdentityContentStatus  @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  beliefs IdentityBeliefMechanism[]
}

model IdentityBeliefMechanism {
  beliefId String
  tagId    String

  belief IdentityBelief       @relation(fields: [beliefId], references: [id], onDelete: Cascade)
  tag    IdentityMechanismTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([beliefId, tagId])
  @@index([tagId])
}

model IdentityPositiveTrunk {
  id        String                 @id @default(cuid())
  beliefId  String                 @unique
  sortOrder Int                    @default(0)
  status    IdentityContentStatus  @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  belief   IdentityBelief           @relation(fields: [beliefId], references: [id], onDelete: Cascade)
  branches IdentityPositiveBranch[]
}

model IdentityPositiveBranch {
  id        String                 @id @default(cuid())
  trunkId   String
  sortOrder Int                    @default(0)
  status    IdentityContentStatus  @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  trunk IdentityPositiveTrunk @relation(fields: [trunkId], references: [id], onDelete: Cascade)

  @@index([trunkId, sortOrder])
}

model IdentityConnector {
  id        String                 @id @default(cuid())
  key       String                 @unique
  kind      IdentityConnectorKind
  status    IdentityContentStatus  @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model IdentityContentTranslation {
  id                String                      @id @default(cuid())
  entityType        IdentityContentEntityType
  entityId          String
  field             String
  locale            String
  draftValue        String                      @default("") @db.Text
  publishedValue    String?                     @db.Text
  translationStatus IdentityTranslationStatus   @default(NOT_TRANSLATED)
  manuallyEdited    Boolean                     @default(false)
  sourceVersion     Int                         @default(1)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId])
  @@index([locale, translationStatus])
}

model IdentityTestSubmission {
  id                String                    @id @default(cuid())
  selectedBeliefIds String[]
  locale            String
  requestId         String?                   @unique // klienta UUID — dubultklikšķu idempotence
  status            IdentitySubmissionStatus  @default(RECEIVED)
  validationNote    String?                   @db.Text
  safetyTriggered   Boolean                   @default(false)
  retainUntil       DateTime?
  clientId          String?
  linkStatus        IdentitySubmissionLinkStatus @default(UNLINKED)
  linkedAt          DateTime?
  linkMethod        IdentitySubmissionLinkMethod?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  client     Client?                          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  result     IdentityTestResult?
  consents   IdentityEmailConsent[]
  sequences  IdentityEmailSequence[]
  deliveries IdentityEmailDelivery[]

  @@index([status, createdAt])
  @@index([clientId, linkStatus])
}

model IdentityTestResult {
  id             String   @id @default(cuid())
  submissionId   String   @unique
  email          String   @db.Text // šifrēts (encryptField)
  emailHash      String   // HMAC-SHA256 meklēšanai, nekad ne plaintext
  name           String?  @db.Text // šifrēts (encryptField) - respondenta vārds
  portraitNow    String   @db.Text // šifrēts (encryptField)
  portraitFuture String   @db.Text // šifrēts (encryptField)
  contentVersion Int      @default(1)
  snapshot       Json?    // pilns ģenerēšanas momentuzņēmums: uzskati+teksti,
                          // fragmenti, tēmu/apakštēmu teksti, savienotājfrāzes
  locale         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission IdentityTestSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  deliveries IdentityEmailDelivery[]

  @@index([emailHash])
}

model IdentityEmailConsent {
  id                  String    @id @default(cuid())
  submissionId        String?
  email               String    @db.Text // šifrēts (encryptField)
  emailHash           String    // HMAC-SHA256
  marketingConsent    Boolean   @default(false)
  consentTimestamp    DateTime  @default(now())
  consentTextVersion  String
  consentSource       String    @default("identity-test")
  withdrawalTimestamp DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  submission IdentityTestSubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  sequences  IdentityEmailSequence[]

  @@index([emailHash])
  @@index([submissionId])
}

model IdentityEmailTemplate {
  id        String                 @id @default(cuid())
  step      IdentityEmailStep      @unique // RESULT | DAY_1 | DAY_3 | DAY_5
  delayDays Int                    @default(0) // RESULT solim ignorējams
  status    IdentityContentStatus  @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model IdentityEmailDelivery {
  id                   String                @id @default(cuid())
  requestId            String                @unique // deterministiska idempotences atslēga:
                                                     // result:{resultId} | seq:{sequenceId}:{step} | admin:{uuid}
  resultId             String?
  submissionId         String?
  recipient            String                @db.Text // šifrēts (encryptField)
  recipientHash        String?               // HMAC-SHA256
  emailKind            IdentityEmailKind
  step                 IdentityEmailStep?
  status               IdentityDeliveryState @default(PENDING)
  attemptCount         Int                   @default(0)
  processingStartedAt  DateTime?             // atomiskas pretenzijas + stale atgūšanai
  nextRetryAt          DateTime?
  lastAttemptAt        DateTime?
  providerMessageId    String?
  lastError            String?               @db.Text
  sentAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  result     IdentityTestResult?     @relation(fields: [resultId], references: [id], onDelete: SetNull)
  submission IdentityTestSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([resultId])
  @@index([submissionId])
}

model IdentityEmailSequence {
  id           String                  @id @default(cuid())
  submissionId String?                 @unique
  consentId    String
  email        String                  @db.Text // šifrēts (encryptField)
  emailHash    String?
  nextStep     IdentityEmailStep
  nextSendAt   DateTime
  status       IdentitySequenceStatus  @default(ACTIVE)
  claimedAt    DateTime?               // PROCESSING pretenzijas laikmets
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  submission IdentityTestSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  consent    IdentityEmailConsent    @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([status, nextSendAt])
  @@index([consentId])
}

model IdentityContentVersion {
  id              String                     @id @default(cuid())
  entityType      IdentityContentEntityType
  entityId        String
  field           String
  locale          String
  previousContent String?                    @db.Text
  newContent      String?                    @db.Text
  action          IdentityVersionAction      @default(UPDATE)
  changedById     String?
  changedAt       DateTime                   @default(now())

  admin AdminUser? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, changedAt])
}

// Kopīgs (multi-instance) rate limit kauss — Postgres ir koplietotā
// stāvokļa vieta Vercel serverless instance vidū.
model SecurityRateLimitBucket {
  key       String   @id // `${scope}:${identifier}`
  count     Int      @default(0)
  resetAt   DateTime // fixed window beigu brīdis
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Slēgtā beta uzaicinājuma tokens. Tiek saglabāts tikai SHA-256 hash —
// neapstrādātais tokens redzams vienu reizi izveides brīdī.
model IdentityBetaInvite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  label       String // testētāja vārds/piezīme (ne obligāti e-pasts)
  maxUses     Int       @default(5)
  uses        Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

model IdentityTestSettings {
  id                  String   @id @default("default")
  publicAccessEnabled Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

// ─── Klienta attīstības karte: kartotēka, stumbri, zari, progress ───

enum IdentitySubmissionLinkStatus {
  UNLINKED
  LINKED
  REVIEW
}

enum IdentitySubmissionLinkMethod {
  AUTO
  MANUAL
}

enum DevelopmentTrunkOrigin {
  LIBRARY
  CUSTOM
}

enum DevelopmentTrunkStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_SUPPLEMENT
}

// Kartotēkas tēma (Dokuments B) — bibliotēkas līmenis, ne klienta kopija.
model BeliefLibraryTheme {
  id                String  @id @default(cuid())
  libraryKey        String  @unique // "01".."10"
  sortOrder         Int     @default(0)
  titleLv           String
  titleEn           String  @default("")
  descriptionLv     String  @default("") @db.Text
  exploreQuestions  String  @default("") @db.Text // speciālista materiāls
  professionalNotes String  @default("") @db.Text // speciālista materiāls
  isSensitive       Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trunks BeliefLibraryTrunk[]
}

// Pozitīvais stumbrs no kartotēkas (bibliotēka, redakcionāls saturs).
model BeliefLibraryTrunk {
  id             String  @id @default(cuid())
  libraryKey     String  @unique // "1.1".."10.5"
  themeId        String
  sortOrder      Int     @default(0)
  titleLv        String  @db.Text
  titleEn        String  @default("") @db.Text
  negativeBelief String  @default("") @db.Text // sasaistes formulējums (LV)
  status         IdentityContentStatus @default(PUBLISHED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  theme         BeliefLibraryTheme     @relation(fields: [themeId], references: [id], onDelete: Restrict)
  branches      BeliefLibraryBranch[]
  beliefLinks   BeliefTrunkLink[]
  clientTrunks  ClientDevelopmentTrunk[]

  @@index([themeId, sortOrder])
}

model BeliefLibraryBranch {
  id        String  @id @default(cuid())
  trunkId   String
  sortOrder Int     @default(0)
  textLv    String  @db.Text
  textEn    String  @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trunk          BeliefLibraryTrunk      @relation(fields: [trunkId], references: [id], onDelete: Cascade)
  clientBranches ClientDevelopmentBranch[]

  @@index([trunkId, sortOrder])
}

// Redakcionāli apstiprināta sasaiste: testa uzskats ↔ kartotēkas stumbrs.
model BeliefTrunkLink {
  id               String  @id @default(cuid())
  beliefId         String
  trunkId          String
  note             String  @default("")
  createdByAdminId String?
  createdAt        DateTime @default(now())

  belief IdentityBelief     @relation(fields: [beliefId], references: [id], onDelete: Cascade)
  trunk  BeliefLibraryTrunk @relation(fields: [trunkId], references: [id], onDelete: Cascade)

  @@unique([beliefId, trunkId])
  @@index([trunkId])
}

// Klienta darba vienība: viens stumbrs ar visiem zariem = viena sesija.
model ClientDevelopmentTrunk {
  id                 String  @id @default(cuid())
  clientId           String
  libraryTrunkId     String?
  beliefId           String?
  beliefIds          String[] @default([]) // visas saistītās negatīvās atbilstības
  origin             DevelopmentTrunkOrigin @default(LIBRARY)
  titleLv            String  @db.Text
  titleEn            String  @default("") @db.Text
  status             DevelopmentTrunkStatus @default(NOT_STARTED)
  sessionId          String?
  completedSessionId String?
  completedAt        DateTime?
  completedByAdminId String?
  sortOrder          Int     @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client           Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  libraryTrunk     BeliefLibraryTrunk?   @relation(fields: [libraryTrunkId], references: [id], onDelete: SetNull)
  belief           IdentityBelief?       @relation(fields: [beliefId], references: [id], onDelete: SetNull)
  session          Session?              @relation("DevelopmentWorkSession", fields: [sessionId], references: [id], onDelete: SetNull)
  completedSession Session?              @relation("DevelopmentCompletedSession", fields: [completedSessionId], references: [id], onDelete: SetNull)
  branches         ClientDevelopmentBranch[]

  @@index([clientId, status])
  @@index([completedSessionId])
}

model ClientDevelopmentBranch {
  id              String  @id @default(cuid())
  clientTrunkId   String
  libraryBranchId String?
  textLv          String  @db.Text
  textEn          String  @default("") @db.Text
  done            Boolean @default(false)
  doneAt          DateTime?
  doneByAdminId   String?
  doneSessionId   String?
  sortOrder       Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientTrunk    ClientDevelopmentTrunk @relation(fields: [clientTrunkId], references: [id], onDelete: Cascade)
  libraryBranch  BeliefLibraryBranch?   @relation(fields: [libraryBranchId], references: [id], onDelete: SetNull)

  @@index([clientTrunkId, sortOrder])
}

// Darba kartes izmaiņu vēsture (audits) — nekad nedzēst.
model ClientDevelopmentEvent {
  id           String  @id @default(cuid())
  clientId     String
  trunkId      String?
  branchId     String?
  action       String
  prevStatus   String?
  newStatus    String?
  detail       String  @default("") @db.Text
  actorAdminId String?
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}
