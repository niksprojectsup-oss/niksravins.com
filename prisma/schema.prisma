generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ChecklistType {
  BEFORE
  CURRENT
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum JournalVisibility {
  PRIVATE
  SHARED
}

enum TestimonialConsent {
  PRIVATE
  ANONYMOUS
  NAMED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GoalStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
}

enum CheckInMood {
  GREAT
  GOOD
  CALM
  NEUTRAL
  ANXIOUS
  LOW
  OVERWHELMED
}

enum AssessmentPhase {
  BEFORE
  AFTER
  ONGOING
}

enum UserRole {
  ADMIN
  CLIENT
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  totpSecret    String?
  lastLoginAt   DateTime?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AuditLog[]   @relation("AdminAuditActor")

  @@index([isActive])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           UserRole
  clientId       String?  @unique
  practitionerId String?
  mfaEnabled     Boolean  @default(false)
  totpSecret     String?
  emailVerified  DateTime?
  passwordSetAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client              Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  authSessions        AuthSession[]
  clientPasswordTokens ClientPasswordToken[]

  @@index([role])
  @@index([practitionerId])
}

model ClientPasswordToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorAdminId String?
  actorRole    UserRole?
  action       String
  resource     String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  admin AdminUser? @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@index([actorAdminId, createdAt])
}

model Client {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  email            String       @unique
  phone            String?
  country          String
  timezone         String       @default("Europe/Riga")
  status           ClientStatus @default(ACTIVE)
  firstSessionDate DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  profile          ClientProfile?
  reactionAnalysis ReactionAnalysis?
  checklists       Checklist[]
  sessions         Session[]
  payments         Payment[]
  bookings         Booking[]
  sessionPackages       SessionPackage[]
  user                  User?
  journalEntries        ClientJournalEntry[]
  checkIns              ClientCheckIn[]
  selfAssessments       ClientSelfAssessment[]
  goals                 ClientGoal[]
  sessionReflections    SessionReflection[]
  sessionPreparations   SessionPreparation[]
  milestones            ClientMilestone[]
  finalReflections      JourneyFinalReflection[]
  testimonials          Testimonial[]

  @@index([status])
  @@index([lastName, firstName])
}

model ClientProfile {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  practitionerNotes  String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ReactionAnalysis {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  mainConcern        String   @default("")
  triggers           String   @default("")
  automaticReactions String   @default("")
  bodySensations     String   @default("")
  emotionalResponses String   @default("")
  oldPatterns        String   @default("")
  currentResponses   String   @default("")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Checklist {
  id        String        @id @default(cuid())
  clientId  String
  type      ChecklistType
  itemKey   String
  checked   Boolean       @default(false)
  updatedAt DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, type, itemKey])
  @@index([clientId, type])
}

model Session {
  id             String        @id @default(cuid())
  clientId       String
  packageId      String?
  sessionNumber  Int?
  scheduledAt    DateTime
  sessionType    String
  serviceId      String?
  status         SessionStatus @default(SCHEDULED)
  mainTopic      String        @default("")
  notes          String        @default("")
  changesNoticed String        @default("")
  nextFocus      String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package       SessionPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  payments      Payment[]
  booking       Booking?
  reflection    SessionReflection?
  preparation   SessionPreparation?

  @@index([clientId, scheduledAt])
  @@index([packageId, sessionNumber])
  @@index([scheduledAt])
  @@index([status])
}

model SessionPackage {
  id                String        @id @default(cuid())
  clientId          String
  serviceId         String
  totalSessions     Int           @default(5)
  completedSessions Int           @default(0)
  status            PackageStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions          Session[]
  booking           Booking?
  payment           Payment?
  finalReflection   JourneyFinalReflection?

  @@index([clientId])
  @@index([status])
}

model ClientJournalEntry {
  id         String            @id @default(cuid())
  clientId   String
  content    String
  prompt     String            @default("")
  visibility JournalVisibility @default(PRIVATE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, visibility])
}

model ClientCheckIn {
  id           String      @id @default(cuid())
  clientId     String
  checkInDate  String
  mood         CheckInMood
  emotionTags  String[]
  intensity    Int
  notes        String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, checkInDate])
  @@index([clientId, checkInDate])
}

model ClientSelfAssessment {
  id                String          @id @default(cuid())
  clientId          String
  phase             AssessmentPhase
  clarity           Int
  confidence        Int
  connection        Int
  movingForward     Int
  emotionalBalance  Int
  feelingStuck      Int
  packageId         String?
  createdAt         DateTime        @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, phase])
}

model ClientGoal {
  id          String     @id @default(cuid())
  clientId    String
  title       String
  description String     @default("")
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  updatedAt   DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model SessionReflection {
  id                       String   @id @default(cuid())
  clientId                 String
  sessionId                String   @unique
  rating                   Int
  valuablePart             String   @default("")
  whatShifted              String   @default("")
  takeaway                   String   @default("")
  messageToPractitioner    String   @default("")
  sharedWithPractitioner   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model SessionPreparation {
  id         String   @id @default(cuid())
  clientId   String
  sessionId  String   @unique
  reflection String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientMilestone {
  id           String   @id @default(cuid())
  clientId     String
  milestoneKey String
  packageId    String?
  achievedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, milestoneKey])
}

model JourneyFinalReflection {
  id             String   @id @default(cuid())
  clientId       String
  packageId      String   @unique
  whatChanged    String   @default("")
  mostValuable   String   @default("")
  selfDiscovery  String   @default("")
  takeForward    String   @default("")
  recommendation String   @default("")
  rating         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client  Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package SessionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Testimonial {
  id        String             @id @default(cuid())
  clientId  String
  packageId String?            @unique
  content   String             @default("")
  consent   TestimonialConsent @default(PRIVATE)
  status    TestimonialStatus  @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  sessionId        String        @unique
  packageId        String?       @unique
  serviceId        String
  slotId           String
  sessionIntention String        @default("")
  status           BookingStatus @default(CONFIRMED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  package SessionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  clientId    String
  sessionId   String?
  packageId   String?       @unique
  amountCents Int
  currency    String        @default("EUR")
  status      PaymentStatus @default(PENDING)
  provider    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  package SessionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sessionId])
}

model BookingSettings {
  id              String   @id @default("default")
  businessTimezone String  @default("Europe/Riga")
  minNoticeHours  Int      @default(24)
  bufferMinutes   Int      @default(15)
  horizonDays     Int      @default(56)
  slotStepMinutes Int      @default(15)
  updatedAt       DateTime @updatedAt
}

model WeeklyAvailability {
  id        String  @id @default(cuid())
  dayOfWeek Int
  enabled   Boolean @default(true)
  startTime String
  endTime   String
  note      String  @default("")

  @@unique([dayOfWeek])
}

model DailyTimeBlock {
  id        String  @id @default(cuid())
  startTime String
  endTime   String
  label     String
  active    Boolean @default(true)

  @@unique([startTime, endTime])
}
