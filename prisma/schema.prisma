generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ChecklistType {
  BEFORE
  CURRENT
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum UserRole {
  ADMIN
  CLIENT
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  totpSecret    String?
  lastLoginAt   DateTime?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AuditLog[]   @relation("AdminAuditActor")

  @@index([isActive])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           UserRole
  clientId       String?  @unique
  practitionerId String?
  mfaEnabled     Boolean  @default(false)
  totpSecret     String?
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  authSessions AuthSession[]

  @@index([role])
  @@index([practitionerId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorAdminId String?
  actorRole    UserRole?
  action       String
  resource     String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  admin AdminUser? @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@index([actorAdminId, createdAt])
}

model Client {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  email            String       @unique
  phone            String?
  country          String
  timezone         String       @default("Europe/Riga")
  status           ClientStatus @default(ACTIVE)
  firstSessionDate DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  profile          ClientProfile?
  reactionAnalysis ReactionAnalysis?
  checklists       Checklist[]
  sessions         Session[]
  payments         Payment[]
  bookings         Booking[]
  user             User?

  @@index([status])
  @@index([lastName, firstName])
}

model ClientProfile {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  practitionerNotes  String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ReactionAnalysis {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  mainConcern        String   @default("")
  triggers           String   @default("")
  automaticReactions String   @default("")
  bodySensations     String   @default("")
  emotionalResponses String   @default("")
  oldPatterns        String   @default("")
  currentResponses   String   @default("")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Checklist {
  id        String        @id @default(cuid())
  clientId  String
  type      ChecklistType
  itemKey   String
  checked   Boolean       @default(false)
  updatedAt DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, type, itemKey])
  @@index([clientId, type])
}

model Session {
  id             String        @id @default(cuid())
  clientId       String
  scheduledAt    DateTime
  sessionType    String
  serviceId      String?
  status         SessionStatus @default(SCHEDULED)
  mainTopic      String        @default("")
  notes          String        @default("")
  changesNoticed String        @default("")
  nextFocus      String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments Payment[]
  booking  Booking?

  @@index([clientId, scheduledAt])
  @@index([scheduledAt])
  @@index([status])
}

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  sessionId        String        @unique
  serviceId        String
  slotId           String
  sessionIntention String        @default("")
  status           BookingStatus @default(CONFIRMED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  clientId    String
  sessionId   String?
  amountCents Int
  currency    String        @default("EUR")
  status      PaymentStatus @default(PENDING)
  provider    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sessionId])
}
